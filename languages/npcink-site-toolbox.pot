"      setIsModalOpen(true);\n"
"      void getMediaData();\n"
"    };\n"
"\n"
"    const handleOk = () => {\n"
"      if (!draftValue) return;\n"
"      onChange?.(draftValue);\n"
"      setIsModalOpen(false);\n"
"    };\n"
"\n"
"    const handleCancel = () => {\n"
"      setDraftValue(value);\n"
"      setIsModalOpen(false);\n"
"    };\n"
"\n"
"    const handleRadioChange = (event: RadioChangeEvent) => {\n"
"      setDraftValue(event.target.value as string);\n"
"    };\n"
"\n"
"    return (\n"
"      <>\n"
"        <div className=\"mabox-image-field\">\n"
"          <div className=\"mabox-image-field-summary\">\n"
